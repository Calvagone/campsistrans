$PROBLEM    2cpt_zo_foce_full
$INPUT      ID ARM TIME EVID MDV AMT CMT RATE DOSENO DV WT METAB TDOS
            TSLD
$DATA      dataset_definf1_defobs1.csv IGNORE=@
$SUBROUTINE ADVAN3 TRANS4
$PK
TVMETAB_CL=THETA(1)
IF (METAB==0) TVMETAB_CL=0
TVCL=(THETA(2) * (1 + TVMETAB_CL))
TVVC=THETA(3)
TVVP=THETA(4)
TVQ=THETA(5)
TVDUR=THETA(6)
TVPROP_RUV=THETA(7)

METAB_CL=TVMETAB_CL
CL=TVCL * EXP(ETA(1))*(WT/70)**(0.75)
VC=TVVC * EXP(ETA(2))*(WT/70)**(1)
VP=TVVP*(WT/70)**(1)
Q=TVQ*(WT/70)**(0.75)
DUR=TVDUR * EXP(ETA(3))
PROP_RUV=TVPROP_RUV
D1=DUR
V1=VC
V2=VP
S1=V1

$ERROR
CONC=A(1)/VC
IF (CONC <= 0.001) CONC=0.001
IPRED=LOG(CONC)
W=PROP_RUV
Y=IPRED + W*EPS(1)

$THETA  (0,0.3) ; THETA_METAB_CL
$THETA  (0,5) ; THETA_CL
$THETA  (0,80) ; THETA_VC
$THETA  (0,200) ; THETA_VP
$THETA  (0,4) ; THETA_Q
$THETA  (0,1.5) ; THETA_DUR
$THETA  (0,0.15) ; THETA_PROP_RUV
$OMEGA  BLOCK(3)
 0.0606246  ;   OMEGA_CL
 0.00303123 0.0606246  ;   OMEGA_VC
 0.00122804 0.00122804 0.00995033  ;  OMEGA_DUR
$SIGMA  1  FIX  ; SIGMA_RUV_FIX
$ESTIMATION METHOD=COND INTERACTION NSIG=2 SIGL=6 MAXEVAL=9999
$COVARIANCE PRINT=E
$TABLE      ID TIME AMT RATE DV CMT MDV EVID ETAS(1:LAST) IPRED
            NOAPPEND ONEHEADER NOPRINT FILE=model.tab

  
