$PROBLEM 2cpt_zo_foce_full
$INPUT ID ARM TIME EVID MDV AMT CMT RATE DOSENO DV WT METAB TDOS TSLD
$DATA dataset_definf1_defobs1.csv IGNORE=@
$SUBROUTINE ADVAN3 TRANS4

$PK
TVMETAB_CL=THETA(1)
IF (METAB==0) TVMETAB_CL=0
TVCL=(THETA(2) * (1 + TVMETAB_CL))
TVVC=THETA(3)
TVVP=THETA(4)
TVQ=THETA(5)
TVDUR=THETA(6)
TVPROP_RUV=THETA(7)

METAB_CL=TVMETAB_CL
CL=TVCL * EXP(ETA(1))*(WT/70)**(0.75)
VC=TVVC * EXP(ETA(2))*(WT/70)**(1)
VP=TVVP*(WT/70)**(1)
Q=TVQ*(WT/70)**(0.75)
DUR=TVDUR * EXP(ETA(3))
PROP_RUV=TVPROP_RUV
D1=DUR
V1=VC
V2=VP
S1=V1

$ERROR
CONC=A(1)/VC
IF (CONC <= 0.001) CONC=0.001
IPRED=LOG(CONC)
W=PROP_RUV
Y=IPRED + W*EPS(1)

$THETA (0,0.3)
$THETA (0,5)
$THETA (0,80)
$THETA (0,200)
$THETA (0,4)
$THETA (0,1.5)
$THETA (0,0.15)
$OMEGA BLOCK(3)
0.0606246
0.00303123 0.0606246
0.00122804 0.00122804 0.00995033
$SIGMA 1 FIX

$EST METHOD=COND INTERACTION NSIG=2 SIGL=6 MAXEVAL=9999
$COV PRINT=E
$TABLE ID TIME AMT RATE DV CMT MDV EVID ETAS(1:LAST) IPRED NOAPPEND ONEHEADER NOPRINT FILE=model.tab
