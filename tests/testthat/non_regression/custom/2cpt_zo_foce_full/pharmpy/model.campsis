[MAIN]
TVMETAB_CL=THETA_METAB_CL
if (METAB == 0) TVMETAB_CL=0
TVCL=THETA_CL*(TVMETAB_CL + 1)
TVVC=THETA_VC
TVVP=THETA_VP
TVQ=THETA_Q
TVDUR=THETA_DUR
TVPROP_RUV=THETA_PROP_RUV
METAB_CL=TVMETAB_CL
CL=0.041321537264558256*TVCL*pow(WT, 0.75)*exp(ETA_CL)
VC=(1.0/70.0)*TVVC*WT*exp(ETA_VC)
VP=(1.0/70.0)*TVVP*WT
Q=0.041321537264558256*TVQ*pow(WT, 0.75)
DUR=TVDUR*exp(ETA_DUR)
PROP_RUV=TVPROP_RUV
D1=DUR
V1=VC
V2=VP
S1=V1

[ODE]
d/dt(A_CENTRAL)=Q*A_PERIPHERAL/V2 + (-CL/V1 - Q/V1)*A_CENTRAL
d/dt(A_PERIPHERAL)=-Q*A_PERIPHERAL/V2 + Q*A_CENTRAL/V1
F=A_CENTRAL/S1

[DURATION]
A_CENTRAL=D1

[ERROR]
CONC=A_CENTRAL/VC
if (CONC <= 0.001) CONC=0.001
IPRED=log(CONC)
W=PROP_RUV
Y=EPS_RSV_FIX*W + IPRED

