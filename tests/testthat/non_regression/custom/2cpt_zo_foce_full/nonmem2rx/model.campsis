[MAIN]
TVMETAB_CL=THETA_METAB_CL
if (METAB == 0) TVMETAB_CL=0
TVCL=(THETA_CL * (1 + TVMETAB_CL))
TVVC=THETA_VC
TVVP=THETA_VP
TVQ=THETA_Q
TVDUR=THETA_DUR
TVPROP_RUV=THETA_PROP_RUV
METAB_CL=TVMETAB_CL
CL=TVCL * exp(ETA_CL) * pow((WT/70), (0.75))
VC=TVVC * exp(ETA_VC) * pow((WT/70), (1))
VP=TVVP * pow((WT/70), (1))
Q=TVQ * pow((WT/70), (0.75))
DUR=TVDUR * exp(ETA_DUR)
PROP_RUV=TVPROP_RUV
DUR_CENTRAL=DUR
V1=VC
V2=VP
SCALE1=V1

[ODE]
d/dt(A_CENTRAL)=Q*A_PERIPHERAL/V2 + (-CL/V1 - Q/V1)*A_CENTRAL
d/dt(A_PERIPHERAL)=-Q*A_PERIPHERAL/V2 + Q*A_CENTRAL/V1
d/dt(A_OUTPUT)=CL*A_CENTRAL/V1
F=A_CENTRAL/SCALE1

[DURATION]
A_CENTRAL=DUR_CENTRAL

[ERROR]
CONC=A_CENTRAL/VC
if (CONC <= 0.001) CONC=0.001
IPRED=log(CONC)
W=PROP_RUV
Y=IPRED + W * EPS_RUV1

